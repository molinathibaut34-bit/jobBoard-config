# =============================================================================
# JobBoard local environment (copy to .env and adjust)
#   cp .env.example .env
# Never commit .env — it contains secrets.
# =============================================================================

# --- PostgreSQL (Docker Compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=jobboard
POSTGRES_USER=admin_jobboard_user
POSTGRES_PASSWORD=admin_jobboard_password

# --- MinIO (Docker Compose + API) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=jobboard-photos
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_BASE_URL=http://localhost:9000
MINIO_USE_SSL=false

# ASP.NET Minio options (optional overrides; defaults map from MINIO_ROOT_*)
Minio__Endpoint=localhost:9000
Minio__AccessKey=minioadmin
Minio__SecretKey=minioadmin
Minio__BucketName=jobboard-photos
Minio__UseSsl=false
Minio__PublicBaseUrl=http://localhost:9000

# --- JWT (API) — change in any shared / non-local environment ---
Jwt__Key=JobBoardDevSecretKey_ChangeMe_AtLeast32Chars!
Jwt__Issuer=jobboard-api
Jwt__Audience=jobboard-front
Jwt__ExpirationMinutes=60

# Connection string is derived from POSTGRES_* if ConnectionStrings__DefaultConnection is empty.
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=jobboard;Username=admin_jobboard_user;Password=admin_jobboard_password

# --- Mailpit (Docker Compose — emails locaux) ---
# UI: http://localhost:8025  |  SMTP: localhost:1025
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
MAILPIT_MAX_MESSAGES=5000

# ASP.NET Email / SMTP (dev → Mailpit)
# Provider: Smtp (default) | Logging (log only, no SMTP)
Email__Provider=Smtp
Email__From=noreply@jobboard.local
Email__FromName=JobBoard
Email__Smtp__Host=localhost
Email__Smtp__Port=1025
Email__Smtp__UseSsl=false
Email__Smtp__Username=
Email__Smtp__Password=

# --- Seed admin (créé au démarrage API si absent) ---
Seed__Admin__Email=admin@jobboard.local
Seed__Admin__Password=Admin123!
Seed__Admin__FirstName=Admin
Seed__Admin__Name=JobBoard

# --- App (liens e-mail reset password, etc.) ---
App__FrontendBaseUrl=http://localhost:4201
App__PasswordResetTokenMinutes=60

# Production example (Brevo SMTP) — override in prod secrets:
# Email__Provider=Smtp
# Email__From=noreply@yourdomain.com
# Email__Smtp__Host=smtp-relay.brevo.com
# Email__Smtp__Port=587
# Email__Smtp__UseSsl=true
# Email__Smtp__Username=your-brevo-login
# Email__Smtp__Password=your-brevo-smtp-key
